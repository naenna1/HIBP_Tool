# ============================================================
# Beispiel-Konfigurationsdatei für das HIBP-Teamprojekt
#
# Jeder Entwickler kopiert diese Datei und benennt sie um zu:
#   .env
# und trägt DORT seinen eigenen gültigen API-Key ein.
# ============================================================

# 🔐 HIBP API Key
# HIBP benötigt einen persönlichen API-Key.
# Beispiel (NUR FÜR Testzwecke!): 00000000000000000000000000000000
HIBP_API_KEY=HIER_DEIN_API_KEY_EINTRAGEN

# 🧭 User Agent
# Der User-Agent ist Pflicht für die HIBP API.
# Bitte so lassen, damit alle Anfragen klar einer Projektgruppe zugeordnet sind.
HIBP_USER_AGENT=hibp-team-project/1.0 (student project)